            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": "{{baseUrl}}/incidencias/{{idIncidenciaLuis}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
