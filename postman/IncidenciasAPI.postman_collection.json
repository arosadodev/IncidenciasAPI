    {
      "name": "02 - Incidencias",
      "item": [
        {
          "name": "Ana crea una incidencia (autor falso en el cuerpo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAna}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/incidencias",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Avería en el aula 12\",\n  \"descripcion\": \"El proyector no enciende\",\n  \"autor\": {\n    \"id\": 2\n  },\n  \"estado\": \"RESUELTA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "El autor y el estado del cuerpo se ignoran: se usan el usuario del token y ABIERTA."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json(); pm.collectionVariables.set(\"idIncidenciaAna\", json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Luis crea una incidencia",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenLuis}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/incidencias",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Ordenador roto\",\n  \"descripcion\": \"El equipo 5 del aula 3 no arranca\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json(); pm.collectionVariables.set(\"idIncidenciaLuis\", json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ana lista sus incidencias",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAna}}"
              }
            ],
            "url": "{{baseUrl}}/incidencias"
