                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ana pide la incidencia de Luis cambiando la URL",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAna}}"
              }
            ],
            "url": "{{baseUrl}}/incidencias/{{idIncidenciaLuis}}",
            "description": "Aquí se ve el reto principal: cambiar el id no da acceso a incidencias ajenas."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
