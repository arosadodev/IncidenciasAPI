          "name": "Estado no permitido",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenTecnico}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/incidencias/{{idIncidenciaAna}}/estado",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"ROTA\"\n}",
